{
  "name": "pumice-cli",
  "version": "0.1.0-alpha.0",
  "description": "Worktree-scoped service guards for finite commands",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coral-535/pumice.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "pumice-daemon": "bin/pumice-daemon.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check bin/pumice-daemon.js && find src test -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
