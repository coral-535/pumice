{
  "name": "pumice-cli",
  "version": "0.1.0-alpha.0",
  "description": "Worktree-scoped service guards for finite commands",
  "homepage": "https://github.com/coral-535/pumice#readme",
  "bugs": {
    "url": "https://github.com/coral-535/pumice/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coral-535/pumice.git"
  },
  "bin": {
    "pumice-daemon": "./dist/daemon-cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "bump": "vp exec bumpp",
    "release": "vp check && vp test && vp run build && vp pm publish",
    "release:stage": "vp check && vp test && vp run build && vp pm stage publish",
    "prepublishOnly": "vp run build",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
